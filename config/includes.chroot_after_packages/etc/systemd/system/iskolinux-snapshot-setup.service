[Unit]
Description=IskoLinux: rendszermentés előkészítése és telepítés utáni mentés (első induláskor)
ConditionPathExists=!/etc/snapper/configs/root
ConditionPathExists=!/run/live/medium
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/iskolinux-snapshot-setup

[Install]
WantedBy=multi-user.target
